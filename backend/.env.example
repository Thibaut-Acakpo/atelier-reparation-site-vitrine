# Copier ce fichier en .env et renseigner les vraies valeurs.
# Ne jamais committer le fichier .env réel.

PORT=4000
NODE_ENV=development

# Origine du frontend (CORS). Les domaines personnalisés des clients sont
# autorisés automatiquement dès qu'ils sont enregistrés dans l'espace développeur.
FRONTEND_URL=http://localhost:5173

# --- PostgreSQL ---------------------------------------------------------
# Soit une URL complète (Render, Neon, Supabase...) :
# DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/base
# Soit les variables classiques :
PGHOST=localhost
PGPORT=5432
PGDATABASE=atelier_reparation
PGUSER=postgres
PGPASSWORD=

# --- Uploads ------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=5242880

# --- Secrets (OBLIGATOIRES en production : openssl rand -hex 32) --------
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=8h
TRACKING_SALT=change_this_secret_in_production
# Optionnel : secret distinct pour l'espace développeur
# DEVELOPER_JWT_SECRET=

# --- Compte développeur (créé par `npm run dev:create`) ------------------
DEVELOPER_EMAIL=
DEVELOPER_PASSWORD=
DEVELOPER_NAME=Développeur

# --- Atelier de démonstration (utilisé uniquement par `npm run seed`) ----
ATELIER_NAME="Atelier de réparation électronique"
ADMIN_EMAIL=admin@atelier-maintenance.bj
ADMIN_PASSWORD=
ASSISTANT_EMAIL=assistant@atelier-maintenance.bj

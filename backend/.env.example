# Copier ce fichier en .env et renseigner les vraies valeurs.
# Ne jamais committer le fichier .env réel.

# Port d'écoute du serveur API
PORT=4000

# Origine autorisée pour le frontend (CORS)
FRONTEND_URL=http://localhost:5173

# Chemin du fichier de base de données SQLite
DATABASE_FILE=./data/atelier.sqlite

# Dossier de stockage des photos uploadées (hors racine publique en production)
UPLOAD_DIR=./uploads

# Taille max d'upload en octets (5 Mo par défaut)
MAX_UPLOAD_SIZE=5242880

# Clé secrète utilisée pour signer les identifiants publics de suivi
# Générer une valeur aléatoire longue en production (ex: openssl rand -hex 32)
TRACKING_SALT=change_this_secret_in_production

# EmailJS (optionnel, pour les notifications email - à activer côté frontend ou via un job)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=

# Nom de l'atelier (utilisé dans les réponses API / templates)
ATELIER_NAME="Atelier de réparation électronique"

# --- Espace administrateur ---------------------------------------------
# Deux comptes/rôles existent :
# - "Technicien"           : le gérant de l'atelier, accès complet
#   (coûts, devis, gestion du contenu du site, modération des avis...).
# - "Assistant technicien" : compte UNIQUE partagé par tous les apprentis.
#   Accès opérationnel (statuts de réparation, diagnostic, pièces,
#   rendez-vous) mais sans visibilité sur les coûts/devis, ni sur la
#   gestion du site ou des avis. Comme ce compte est partagé, les actions
#   qu'il effectue ne sont pas attribuables à un apprenti en particulier.

# Clé secrète de signature des jetons JWT de l'espace admin.
# Générer une vraie valeur en production (ex: openssl rand -hex 32)
JWT_SECRET=change_this_secret_in_production

# Durée de validité d'un jeton de connexion admin
JWT_EXPIRES_IN=8h

# Identifiants du compte "Technicien" (gérant, accès complet), créés
# automatiquement par `npm run seed` si ce compte n'existe pas encore.
# À changer immédiatement après la première connexion — aucune interface de
# création de compte n'est exposée publiquement, par sécurité. Si vous
# modifiez ces valeurs après le premier `npm run seed`, relancez
# `npm run admin:reset` pour les appliquer réellement (le seed ne crée le
# compte qu'une seule fois).
ADMIN_EMAIL=admin@atelier-maintenance.bj
ADMIN_PASSWORD=

# Identifiants du compte "Assistant technicien" (partagé, accès restreint),
# créés automatiquement par `npm run seed` si ce compte n'existe pas encore.
# Communiquez-les à vos apprentis ; changez-les via `npm run admin:reset`
# si besoin (ex. changement d'apprenti).
ASSISTANT_EMAIL=assistant@atelier-maintenance.bj
ASSISTANT_PASSWORD=
